{
  "name": "@zlzlge/autodata",
  "version": "0.1.0-rc.1",
  "description": "A self-evolving data harness distributed as an external DeepSeek Harness bundle",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZLZLGe/autodata.git"
  },
  "homepage": "https://github.com/ZLZLGe/autodata#readme",
  "bugs": {
    "url": "https://github.com/ZLZLGe/autodata/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./service": {
      "types": "./lib/service.d.ts",
      "import": "./lib/service.js",
      "default": "./lib/service.js"
    },
    "./tool": {
      "types": "./lib/tool.d.ts",
      "import": "./lib/tool.js",
      "default": "./lib/tool.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:profile": "pnpm run build && node scripts/profile-smoke.mjs",
    "pack:check": "npm pack --dry-run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run test:profile && pnpm run pack:check",
    "prepare": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.10.1",
    "js-yaml": "4.1.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
